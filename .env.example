DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Optional. When set, completed results are written to Vercel Blob and the
# UI fetches them from the CDN URL stored in operations.result_url.
# When unset (typical for local dev), results are written to the OS temp
# directory and served via /api/operations/result/[id].
BLOB_READ_WRITE_TOKEN=
